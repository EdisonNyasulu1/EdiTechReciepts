# Copy to ".env" only if you need to change something (Windows: copy .env.example .env).
# The defaults below already work for local development.

# Leave as /api normally. In development Vite forwards it to the backend; on Vercel, vercel.json forwards it.
# Set a full address (https://your-backend.onrender.com/api) ONLY if you do not use the Vercel forwarding.
VITE_API_URL=/api

# Where the dev server forwards /api (your local backend)
VITE_DEV_API_TARGET=http://localhost:5000
